# ==============================================================================
# 1. SERVER & APPLICATION CONFIG
# ==============================================================================
APP_NAME="Hackathon-AI-Backend"
APP_ENV="development"          # development | staging | production
APP_VERSION="0.1.0"
HOST="0.0.0.0"
PORT=8000
DEBUG=true
RELOAD=true
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500,*"

# ==============================================================================
# 2. GROQ CONFIG (Ultra-Fast Inference / Real-time Chat / Routing)
# Get API Key: https://console.groq.com/keys
# ==============================================================================
# Multiple keys (comma-separated, no spaces) -> auto round-robin + failover on rate limit
GROQ_API_KEYS="gsk_key_one,gsk_key_two,gsk_key_three"
GROQ_DEFAULT_MODEL="llama-3.3-70b-versatile"
GROQ_FAST_MODEL="llama-3.1-8b-instant"
GROQ_REASONING_MODEL="openai/gpt-oss-120b"
GROQ_WHISPER_MODEL="whisper-large-v3-turbo"

# ==============================================================================
# 3. GOOGLE GEMINI CONFIG (Multimodal / Long Context 1M+ / Structured JSON)
# Get API Key: https://aistudio.google.com/app/apikey
# ==============================================================================
GEMINI_API_KEY="AIzaSy_your_gemini_api_key_here"
GEMINI_DEFAULT_MODEL="gemini-2.5-flash"
GEMINI_PRO_MODEL="gemini-2.5-pro"

# ==============================================================================
# 4. HUGGINGFACE EMBEDDINGS CONFIG (RAG / Semantic Search / pgvector)
# Get Token: https://huggingface.co/settings/tokens
# ==============================================================================
HF_TOKEN="hf_your_huggingface_token_here"
# 384-dim fast model: BAAI/bge-small-en-v1.5 or sentence-transformers/all-MiniLM-L6-v2
# 1024-dim multilingual model: BAAI/bge-m3
HF_EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
HF_EMBEDDING_DIM=384
USE_LOCAL_EMBEDDINGS=false     # true = sentence-transformers locally, false = HF Inference API

# ==============================================================================
# 5. AUTH & DATABASE CONFIG (Recommended: Supabase PostgreSQL + pgvector + Auth)
# Get Keys: https://supabase.com/dashboard/project/_/settings/api
# ==============================================================================
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="eyJ_your_supabase_anon_public_key"
SUPABASE_SERVICE_ROLE_KEY="eyJ_your_supabase_service_role_secret_key"
SUPABASE_JWT_SECRET="your_supabase_jwt_secret_for_fastapi_verification"
DATABASE_URL="postgresql://postgres:your_password@db.your-project-id.supabase.co:5432/postgres"

# (Optional Alternative) Firebase Admin Config if using Firebase Auth/Firestore
FIREBASE_PROJECT_ID=""
FIREBASE_CREDENTIALS_PATH="./firebase-service-account.json"
